{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "title": "GitWyrm",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 11
        },
        "dragDropEnabled": false,
        "backgroundColor": "#121212"
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
