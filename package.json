{
  "name": "gitwyrm-mockup",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run free-port && vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "free-port": "node scripts/free-port.mjs",
    "typecheck": "tsc -b --force",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test": "npm run typecheck && npm run test:unit && npm run test:rust && tauri dev",
    "bootstrapper:dev": "cargo run --manifest-path src-tauri/bootstrapper/Cargo.toml --release -- --dry-run",
    "bootstrapper:updater:dev": "cargo run --manifest-path src-tauri/bootstrapper/Cargo.toml --release -- --updating --dry-run",
    "bootstrapper:updater:dev:error": "cargo run --manifest-path src-tauri/bootstrapper/Cargo.toml --release -- --updating --dry-run --fail"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
